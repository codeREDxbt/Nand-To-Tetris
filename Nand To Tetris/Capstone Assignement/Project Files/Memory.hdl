// Memory.hdl - the Hack data memory.
//
//   address 0     .. 16383 : RAM16K
//   address 16384 .. 24575 : Screen
//   address 24576          : Keyboard
//
// The top two address bits (13 and 14) pick the part:
//   00, 01 -> RAM    10 -> Screen    11 -> Keyboard

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Send "load" only to the part that the address points to.
    DMux4Way(in=load, sel=address[13..14], a=ramLoadA, b=ramLoadB, c=screenLoad);
    Or(a=ramLoadA, b=ramLoadB, out=ramLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    // Read from the part that the address points to.
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=keyboardOut,
              sel=address[13..14], out=out);
}
